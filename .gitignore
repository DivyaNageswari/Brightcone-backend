**/config/local.yaml
**/config/*.local.yaml

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# include cargo lock
!Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

*.sqlite
*.sqlite-*

# Output of `make seed` / `cargo loco task seed_demo`: it prints every demo
# password in plain text, so it must never reach Git.
seed.out

# local env (keep the example)
.env
.env.*
!.env.example
