# Copy to .env (git-ignored). These are DEVELOPMENT values only. Never reuse them in production.

# Application database credentials (native PostgreSQL on port 5432)
POSTGRES_PASSWORD=postgres
SCHEMA_SYNC_PASSWORD=schema_sync_dev_pw
RUNTIME_PASSWORD=runtime_dev_pw
QUEUE_PASSWORD=queue_dev_pw

# Database connection URLs (native PostgreSQL on port 5432)
DATABASE_URL=postgres://app_runtime:runtime_dev_pw@localhost:5432/brightcone_dev
# Startup schema sync needs DDL permission. Keep this separate from the runtime role.
SCHEMA_SYNC_DATABASE_URL=postgres://app_schema_sync:schema_sync_dev_pw@localhost:5432/brightcone_dev
# The job queue has its own role and schema (Loco creates its queue tables at start-up)
QUEUE_URL=postgres://app_queue:queue_dev_pw@localhost:5432/brightcone_dev
TEST_QUEUE_URL=postgres://app_queue:queue_dev_pw@localhost:5432/brightcone_test
# Tests use their own database and RESET its contents at app startup. Never point this at dev data.
TEST_DATABASE_URL=postgres://app_schema_sync:schema_sync_dev_pw@localhost:5432/brightcone_test

# MUST be valid standard base64. Generate a unique local value with
# `openssl rand -base64 48` and place it in ignored .env (do not commit it).
JWT_SECRET=

LOG_LEVEL=debug
MAILER_HOST=localhost
