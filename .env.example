# Copy to .env (git-ignored). These are DEVELOPMENT values only. Never reuse them in production.

# --- used by docker compose on first start ---
POSTGRES_PASSWORD=postgres
MIGRATOR_PASSWORD=migrator_dev_pw
RUNTIME_PASSWORD=runtime_dev_pw
QUEUE_PASSWORD=queue_dev_pw

# --- used by the app ---
# Host port is 5433 because a native Windows PostgreSQL commonly occupies 5432.
# If your 5432 is free, change every URL below AND the `5433:5432` mapping in
# docker-compose.yml back to 5432 together.
DATABASE_URL=postgres://app_runtime:runtime_dev_pw@localhost:5433/brightcone_dev
# The job queue has its own role and schema (Loco creates its queue tables at start-up)
QUEUE_URL=postgres://app_queue:queue_dev_pw@localhost:5433/brightcone_dev
# Migrations connect as app_migrator (make migrate)
MIGRATION_DATABASE_URL=postgres://app_migrator:migrator_dev_pw@localhost:5433/brightcone_dev
# Tests use their own database and WIPE it. Never point this at the dev database.
TEST_DATABASE_URL=postgres://app_migrator:migrator_dev_pw@localhost:5433/brightcone_test

# MUST be valid standard base64. Generate a unique local value with
# `openssl rand -base64 48` and place it in ignored .env (do not commit it).
JWT_SECRET=

LOG_LEVEL=debug
MAILER_HOST=localhost
