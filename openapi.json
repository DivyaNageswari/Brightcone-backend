{
  "openapi": "3.1.0",
  "info": {
    "title": "Brightcone People API",
    "description": "",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/admin/users": {
      "get": {
        "tags": [
          "admin_users"
        ],
        "summary": "Lists accounts, 25 per page by default.",
        "operationId": "list",
        "responses": {
          "200": {
            "description": "A page of accounts"
          },
          "403": {
            "description": "HR Admin only"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "admin_users"
        ],
        "summary": "Creates an account with a temporary password the person must change at first sign-in.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemporaryPasswordResponse"
                }
              }
            }
          },
          "409": {
            "description": "E-mail already used"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/users/{pid}/disable": {
      "post": {
        "tags": [
          "admin_users"
        ],
        "summary": "Disables an account and signs it out everywhere.",
        "operationId": "disable",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account disabled"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/users/{pid}/reset-password": {
      "post": {
        "tags": [
          "admin_users"
        ],
        "summary": "Sets a new temporary password (shown once) and signs the person out everywhere.",
        "operationId": "reset_password",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Temporary password, shown once",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TemporaryPasswordResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/users/{pid}/role": {
      "put": {
        "tags": [
          "admin_users"
        ],
        "summary": "Changes an account's role.",
        "operationId": "set_role",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetRoleParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Role changed"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/admin/users/{pid}/unlock": {
      "post": {
        "tags": [
          "admin_users"
        ],
        "summary": "Unlocks a locked account, or re-enables a disabled one.",
        "operationId": "unlock",
        "parameters": [
          {
            "name": "pid",
            "in": "path",
            "description": "Account id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account is active again"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "audit_log"
        ],
        "summary": "Who did what and when, newest first.",
        "operationId": "list",
        "parameters": [
          {
            "name": "before_id",
            "in": "query",
            "description": "Page cursor",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "1 to 200, default 50",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          },
          {
            "name": "action_prefix",
            "in": "query",
            "description": "Filter, e.g. auth.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actor_user_id",
            "in": "query",
            "description": "Filter by who did it",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "403": {
            "description": "HR Admin only"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/auth/forgot": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Asks for a reset link. The answer is always the same, so nobody can discover which e-mails exist.",
        "operationId": "forgot",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Always succeeds",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Signs a user in with e-mail and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in. The refresh token is set as an HttpOnly cookie.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "E-mail or password is incorrect"
          },
          "403": {
            "description": "Account locked or disabled (code account_locked / account_disabled)"
          },
          "429": {
            "description": "Too many attempts"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Ends the session. Always answers 204, even if the cookie was already invalid.",
        "operationId": "logout",
        "parameters": [
          {
            "name": "all",
            "in": "query",
            "description": "Sign out on every device",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out; the refresh cookie is deleted"
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Swaps the refresh cookie for a new one and returns a fresh access token.",
        "operationId": "refresh",
        "responses": {
          "200": {
            "description": "New access token; the refresh cookie is replaced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid refresh cookie"
          }
        }
      }
    },
    "/api/auth/reset": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sets a new password using the link from the e-mail.",
        "operationId": "reset",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed; all sessions were signed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Link invalid or expired, or password too weak"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness plus a database check. Used by monitoring and the frontend start page.\nReturns 503 when the database does not answer so load balancers stop sending traffic.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Server and database are up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database is not answering",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Who am I and what may I do? Called by the frontend after sign-in and after a page reload.",
        "operationId": "current",
        "responses": {
          "200": {
            "description": "The signed-in user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/api/me/password": {
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Changes the password and signs out every other device. Returns a fresh session for this one.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordParams"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Password changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Current password wrong, or new password too weak"
          },
          "401": {
            "description": "Not signed in"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdminUserResponse": {
        "type": "object",
        "required": [
          "pid",
          "email",
          "name",
          "role",
          "status",
          "failed_logins",
          "must_change_password",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "failed_logins": {
            "type": "integer",
            "format": "int32"
          },
          "last_login_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "must_change_password": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "pid": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "AuditEntryResponse": {
        "type": "object",
        "required": [
          "id",
          "at",
          "action"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_email": {
            "type": [
              "string",
              "null"
            ]
          },
          "at": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "target_type": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AuditPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryResponse"
            }
          },
          "next_before_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Pass this as `before_id` to get the next page. Absent on the last page."
          }
        }
      },
      "ChangePasswordParams": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string"
          },
          "new_password": {
            "type": "string"
          }
        }
      },
      "CreateUserParams": {
        "type": "object",
        "required": [
          "email",
          "name",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "example": "employee"
          }
        }
      },
      "ForgotParams": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "Result of the health check. `database` is `\"ok\"` or `\"down\"`.",
        "required": [
          "status",
          "database"
        ],
        "properties": {
          "database": {
            "type": "string",
            "example": "ok"
          },
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "LoginParams": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "example": "ananya.rao@brightcone.ai"
          },
          "password": {
            "type": "string"
          },
          "remember": {
            "type": "boolean",
            "description": "\"Keep me signed in\": the refresh cookie lasts days instead of the browser session."
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "description": "Who the signed-in user is and what they may do.",
        "required": [
          "pid",
          "email",
          "name",
          "role",
          "must_change_password",
          "permissions"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "must_change_password": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "`resource:action:scope`, for example `approvals:decide:team`."
          },
          "pid": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "example": "employee"
          }
        }
      },
      "MessageResponse": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "ResetParams": {
        "type": "object",
        "required": [
          "token",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "SessionResponse": {
        "type": "object",
        "description": "Returned by login, refresh and change-password. The refresh token travels separately, in an\n`HttpOnly` cookie that scripts cannot read.",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "format": "int64",
            "description": "Seconds until the access token expires.",
            "minimum": 0
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "user": {
            "$ref": "#/components/schemas/MeResponse"
          }
        }
      },
      "SetRoleParams": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "example": "manager"
          }
        }
      },
      "TemporaryPasswordResponse": {
        "type": "object",
        "description": "Returned once. The temporary password cannot be shown again.",
        "required": [
          "user",
          "temporary_password"
        ],
        "properties": {
          "temporary_password": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AdminUserResponse"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
